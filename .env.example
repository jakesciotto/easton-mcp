# Canonical server URL. It is the token audience.
MCP_PUBLIC_URL=
# Ed25519 private key that signs access tokens.
MCP_JWT_SIGNING_KEY=
# Allowed callback URLs: the claude.ai callback plus the loopback forms.
MCP_ALLOWED_REDIRECTS=
# Hosts allowed to serve Client ID Metadata Documents.
MCP_CIMD_HOSTS=
# Google Group email whose members are admins.
MCP_ADMIN_GROUP=
# Google login client id for coaches.
GOOGLE_OAUTH_CLIENT_ID=
# Google login client secret for coaches.
GOOGLE_OAUTH_CLIENT_SECRET=
# Service account email with domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account private key for domain-wide delegation.
GOOGLE_PRIVATE_KEY=
# Workspace admin email used for Directory API group reads.
GOOGLE_WORKSPACE_ADMIN_EMAIL=
# Leaderboard Supabase project URL.
LEADERBOARD_SUPABASE_URL=
# Leaderboard publishable key. RLS stays enforced.
LEADERBOARD_SUPABASE_PUBLISHABLE_KEY=
# Server state Supabase project URL.
MCP_SUPABASE_URL=
# Server state project service role key. Never a product project key.
MCP_SUPABASE_SERVICE_ROLE_KEY=
# PostHog project key for tool call events.
POSTHOG_KEY=
